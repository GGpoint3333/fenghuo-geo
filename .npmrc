registry=https://registry.npmjs.org/
manage-package-manager-versions=false
# This workspace is a pure-JS project: every native binary (Tailwind oxide,
# lightningcss, next-swc, sharp) ships as a prebuilt optional platform package,
# so no dependency build script is required. Skip pnpm 11's implicit
# "install before run" step (which otherwise fails on ignored build scripts).
verifyDepsBeforeRun=false
# Keep a flat node_modules: avoids pnpm's symlink/junction recursion on
# Windows paths containing non-ASCII characters.
node-linker=hoisted
