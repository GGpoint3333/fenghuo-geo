# ------------------------------------------------------------------
# 风火GEO · 监测内核密钥（全部可选）
# 复制为 .env 后填写；未配置的引擎自动跳过，报告里标注「未配置」，不会中断。
# ------------------------------------------------------------------

# DeepSeek（建议先用这个跑单引擎真实采样，成本最低）
DEEPSEEK_API_KEY=
# 豆包 · 火山方舟（需在方舟控制台创建「接入点」，并用 ARK_MODEL 指定其 ID）
ARK_API_KEY=
ARK_MODEL=
# 通义千问 · 阿里云百炼（DashScope 兼容模式）
DASHSCOPE_API_KEY=
# Kimi · 月之暗面 Moonshot
MOONSHOT_API_KEY=
# GPT · OpenAI
OPENAI_API_KEY=
# Gemini · Google AI Studio
GEMINI_API_KEY=
# 文心一言 · 百度千帆（本项目新增适配器，上游 geo-doctor 未内置）
QIANFAN_API_KEY=
# 腾讯元宝：无稳定公开 API，mode=manual，不读取任何密钥
# YUANBAO_API_KEY=   （留空，仅作占位说明）

# 单次全引擎采样预算上限（人民币等值 token 估算），超限停止并输出已采部分
GEO_BUDGET_CNY=5

# 官网站点地址（用于 canonical / OG / sitemap / llms.txt / RSS）
NEXT_PUBLIC_SITE_URL=https://fenghuo-geo.example.com
